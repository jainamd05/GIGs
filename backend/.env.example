# ---------------------------------------------------------------------------
# Sahayak backend configuration
# Copy this file to `.env` and fill in real values.
# Every integration below is OPTIONAL: if the credentials are missing the
# server still runs and "simulates" the notification (logs it + adds it to the
# in-app activity feed). Nothing breaks when a section is left blank.
# ---------------------------------------------------------------------------

# Server
PORT=4000
# Fairness cooldown applied to a worker after they are hired (hours).
# The real project uses 12. Lower it (e.g. 0.02 = ~1 min) to demo cooldown fast.
COOLDOWN_HOURS=12

# Where the SQLite database file lives (relative to backend/).
DB_FILE=sahayak.db

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Email via SMTP (nodemailer). Leave blank to simulate.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password>  (NOT your normal password).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sahayak <no-reply@sahayak.local>"

# ---------------------------------------------------------------------------
# Twilio — SMS + WhatsApp. Leave blank to simulate.
# TWILIO_ACCOUNT_SID  starts with "AC..."
# TWILIO_AUTH_TOKEN   from the Twilio console
# TWILIO_SMS_FROM      a Twilio SMS-capable number, e.g. +14155551234
# TWILIO_WHATSAPP_FROM the Twilio WhatsApp sender, e.g. whatsapp:+14155238886
#                      (the sandbox number works for testing)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Channel toggles (true/false). Email is always attempted.
ENABLE_SMS=true
ENABLE_WHATSAPP=true
